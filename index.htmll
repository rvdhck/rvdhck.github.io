    <tr><td>3</td><td><strong>Deep Push-Ups</strong></td><td>3 &times; 8-12</td><td>Parallettes</td></tr>
    <tr><td>4</td><td><strong>Bodyweight Squats</strong></td><td>3 &times; 15-20</td><td>Yoga mat</td></tr>
    <tr><td>5</td><td><strong>L-Sit Holds</strong></td><td>3 &times; max hold</td><td>Parallettes</td></tr>
    <tr><td>6</td><td><strong>Hollow Body Hold</strong></td><td>3 &times; 20-45s</td><td>Yoga mat</td></tr>
  </tbody></table>
</div>
<div class="day-card">
  <div class="day-header"><h3>Wednesday &mdash; Full Body B</h3><span class="day-badge">Day 2</span></div>
