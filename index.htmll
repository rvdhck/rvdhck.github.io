<!-- PAGE: TRACKER -->
<div id="page-tracker" class="page-content">
<div class="page">
<div class="chapter"><div class="chapter-number">Interactive</div><h2>Progress Tracker</h2><p>Log your weekly stats. Everything saved to your browser.</p></div>

<div class="track-card">
  <h3>Your Profile</h3>
  <div class="input-row">
    <div class="input-group"><label>Your Name</label><input type="text" id="profName" value="Ismail" style="min-width:150px;"></div>
    <div class="input-group"><label>Goal Weight (kg)</label><input type="number" id="profGoal" placeholder="e.g. 65" style="min-width:100px;"></div>
    <div class="input-group"><label>Start Date</label><input type="date" id="profStart"></div>
  </div>
</div>

<div class="track-card">
  <h3>Log Weekly Stats</h3>
  <div class="input-row">
    <div class="input-group"><label>Week</label><input type="number" id="entryWeek" min="1" value="1" style="width:70px;"></div>
    <div class="input-group"><label>Weight (kg)</label><input type="number" id="entryWeight" step="0.1" placeholder="e.g. 55" style="width:90px;"></div>
    <div class="input-group"><label>Pull-Up Max</label><input type="number" id="entryPullup" placeholder="e.g. 5" style="width:80px;"></div>
    <div class="input-group"><label>Dip Max</label><input type="number" id="entryDip" placeholder="e.g. 10" style="width:80px;"></div>
    <div class="input-group"><label>L-Sit (sec)</label><input type="number" id="entryLsit" placeholder="e.g. 15" style="width:80px;"></div>
    <div class="input-group"><label>Notes</label><input type="text" id="entryNotes" placeholder="How you feeling?" style="min-width:150px;"></div>
    <div class="input-group" style="justify-content:end;"><button class="btn btn-primary" id="saveEntry">Save</button></div>
  </div>
</div>

<div class="track-card">
  <h3>Body Measurements (cm)</h3>
  <div class="input-row">
    <div class="input-group"><label>Arm</label><input type="number" id="measArm" step="0.1" placeholder="cm" style="width:70px;"></div>
    <div class="input-group"><label>Chest</label><input type="number" id="measChest" step="0.1" placeholder="cm" style="width:70px;"></div>
    <div class="input-group"><label>Waist</label><input type="number" id="measWaist" step="0.1" placeholder="cm" style="width:70px;"></div>
    <div class="input-group"><label>Thigh</label><input type="number" id="measThigh" step="0.1" placeholder="cm" style="width:70px;"></div>
    <div class="input-group" style="justify-content:end;"><button class="btn btn-success btn-sm" id="saveMeas">Save</button></div>
  </div>
</div>

<div class="track-card">
  <h3>Progress Chart</h3>
  <div class="legend">
    <span><span class="dot" style="background:#e94560;"></span> Weight</span>
    <span><span class="dot" style="background:#4ecca3;"></span> Pull-Ups</span>
    <span><span class="dot" style="background:#5352ed;"></span> Dips</span>
  </div>
  <div class="chart-box" id="chartBox"><p style="color:var(--text-dim);font-size:14px;">Add weekly entries to see your progress chart.</p></div>
</div>

<div class="track-card">
  <h3>History</h3>
  <div id="historyBox"><p style="color:var(--text-dim);font-size:14px;">No entries yet. Log your first week above!</p></div>
</div>

<div class="track-card">
  <h3>Milestones</h3>
  <ul class="checklist">
    <li id="m1">First full pull-up</li>
    <li id="m5">5 consecutive pull-ups</li>
    <li id="m10">10 full dips</li>
    <li id="m30">30-second L-sit</li>
    <li id="mp">Full pistol squat</li>
  </ul>
</div>

<div class="track-card">
  <h3>Backup Data</h3>
  <div style="display:flex;gap:10px;flex-wrap:wrap;">
    <button class="btn btn-primary btn-sm" id="exportBtn">Download Backup</button>
    <button class="btn btn-secondary btn-sm" id="importBtn">Restore Backup</button>
    <input type="file" id="importInput" accept=".json" style="display:none">
    <button class="btn btn-danger btn-sm" id="clearBtn">Clear All Data</button>
  </div>
  <p style="margin-top:8px;font-size:12px;color:var(--text-dim);">Backup includes workouts, progress, measurements, profile, and theme.</p>
</div>
</div>
</div>

<script>
(function() {
  'use strict';

  // ====== QUOTES ======
  var QUOTES = [
    { t:'The only bad workout is the one that didn\'t happen.', a:'Unknown' },
    { t:'Strength does not come from the body. It comes from the will.', a:'Unknown' },
    { t:'The body achieves what the mind believes.', a:'Napoleon Hill' },
    { t:'It never gets easier. You just get stronger.', a:'Unknown' },
    { t:'Don\'t count the days. Make the days count.', a:'Mike Tyson' },
    { t:'You don\'t have to be extreme, just consistent.', a:'Unknown' },
    { t:'The pain you feel today will be the strength you feel tomorrow.', a:'Arnold Schwarzenegger' },
    { t:'Your only limit is the one you set for yourself.', a:'Unknown' },
    { t:'Focus on progress, not perfection.', a:'Unknown' },
    { t:'The best project you\'ll ever work on is you.', a:'Unknown' },
    { t:'Be stronger than your strongest excuse.', a:'Unknown' },
    { t:'Small daily improvements over time lead to stunning results.', a:'Unknown' }
  ];
  function showQuote() {
    var q = QUOTES[Math.floor(Math.random() * QUOTES.length)];
    document.getElementById('quoteText').textContent = q.t;
    document.getElementById('quoteAuthor').textContent = '\u2014 ' + q.a;
  }

  // ====== THEME ======
  function getTheme() { return localStorage.getItem('icb_theme') || 'dark'; }
  function setTheme(t) {
    document.documentElement.setAttribute('data-theme', t);
    localStorage.setItem('icb_theme', t);
    document.getElementById('themeBtn').textContent = t === 'dark' ? '\uD83C\uDF19' : '\u2600\uFE0F';
  }
  function toggleTheme() {
    var cur = document.documentElement.getAttribute('data-theme') || 'dark';
    setTheme(cur === 'dark' ? 'light' : 'dark');
  }

  // ====== DATA ======
  var DAYS = ['mon','wed','fri'];
  var DAY_LABELS = { mon:'Monday', wed:'Wednesday', fri:'Friday' };
  var DAY_PLANS = { mon:'Full Body A', wed:'Full Body B', fri:'Full Body C' };
  var EXERCISES = {
    mon: [
      { n:'Pull-Ups', t:'4 \u00d7 3-8', e:'Pull-up bar', p:['Negatives','Band','Full','Narrow','Archer'] },
      { n:'Dips', t:'4 \u00d7 6-10', e:'Dip bars', p:['Bench','Band','Full','Weighted'] },
      { n:'Push-Ups', t:'3 \u00d7 8-12', e:'Parallettes', p:['Wall','Incline','Knee','Full','Deep','Decline'] },
      { n:'Bodyweight Squats', t:'3 \u00d7 15-20', e:'Yoga mat', p:['Assisted','Full','Narrow','Pistol'] },
      { n:'L-Sit', t:'3 \u00d7 max', e:'Parallettes', p:['Tuck','One-leg','Full','Strict'] },
      { n:'Hollow Body', t:'3 \u00d7 20-45s', e:'Yoga mat', p:['Dead Bug','Basic','Advanced','Weighted'] }
    ],
    wed: [
      { n:'Australian Rows', t:'4 \u00d7 10-15', e:'Under bar', p:['Band','Full','Narrow','Archer'] },
      { n:'Pike Push-Ups', t:'4 \u00d7 8-12', e:'Yoga mat', p:['Incline','Full','Diamond'] },
      { n:'Bulgarian Split Squats', t:'3 \u00d7 8-12/leg', e:'Mat + chair', p:['Assisted','Full','Weighted'] },
      { n:'Glute Bridges', t:'3 \u00d7 15-20', e:'Yoga mat', p:['Basic','Single-leg','Weighted'] },
      { n:'Leg Raises', t:'3 \u00d7 10-15', e:'Yoga mat', p:['Knee Tuck','Full','Hanging'] },
      { n:'Plank', t:'3 \u00d7 30-60s', e:'Yoga mat', p:['Knee','Full','Weighted'] }
    ],
    fri: [
      { n:'Pull-Ups', t:'4 \u00d7 3-8', e:'Pull-up bar', p:['Negatives','Band','Full','Narrow','Archer'] },
      { n:'Dips', t:'4 \u00d7 6-10', e:'Dip bars', p:['Bench','Band','Full','Weighted'] },
      { n:'Wide Push-Ups', t:'3 \u00d7 10-15', e:'Parallettes', p:['Wall Wide','Incline Wide','Knee Wide','Full Wide'] },
      { n:'Walking Lunges', t:'3 \u00d7 10-12/leg', e:'Yoga mat', p:['Assisted','Full','Weighted'] },
      { n:'Calf Raises', t:'3 \u00d7 20-25', e:'Off a step', p:['Double','Single','Weighted'] },
      { n:'Russian Twists', t:'3 \u00d7 15-20/side', e:'Yoga mat', p:['Basic','Weighted'] }
    ]
  };
  function setCount(s) { var m = s.match(/^(\d+)/); return m ? parseInt(m[1]) : 3; }
  function defaultReps(ex) {
    var m = ex.t.match(/×\s*(\d+)-(\d+)/);
    if (m) return Math.round((parseInt(m[1]) + parseInt(m[2])) / 2);
    if (ex.t.indexOf('max hold') >= 0 || ex.t.indexOf('s') >= 0) return 1;
    return 8;
  }
  function defaultRepsFromTarget(t) {
    var m = t.match(/×\s*(\d+)-(\d+)/);
    if (m) return Math.round((parseInt(m[1]) + parseInt(m[2])) / 2);
    if (t.indexOf('max') >= 0 || t.indexOf('s') >= 0) return 1;
    return 8;
  }
  function getExProg(day, ei) { return loadData('exprog_'+day+'_'+ei, 0); }
  function setExProg(day, ei, v) { saveData('exprog_'+day+'_'+ei, v); }
  function progTarget(t, level, maxLevel) {
    var m = t.match(/^(\d+)\s*×\s*(\d+)-(\d+)/);
    if (!m || !maxLevel) return t;
    var sets = m[1], lo = parseInt(m[2]), hi = parseInt(m[3]);
    var shift = Math.round((hi - lo) * (maxLevel - level) / maxLevel);
    return sets + ' × ' + (lo + shift) + '-' + (hi + shift);
  }

  function loadData(k, d) { try { var v = localStorage.getItem('icb_'+k); return v ? JSON.parse(v) : d; } catch(e) { return d; } }
  function saveData(k, v) { localStorage.setItem('icb_'+k, JSON.stringify(v)); }

  // ====== WORKOUT LOG ======
  var curDay = 'mon';
  var restInt = null;
  var restSec = 90;
  var restRun = false;

  function getWK() { return loadData('workout', { mon:{}, wed:{}, fri:{} }); }
  function saveWK(d) { saveData('workout', d); }

  function todayKey() {
    var d = new Date().getDay();
    if (d === 1) return 'mon';
    if (d === 3) return 'wed';
    if (d === 5) return 'fri';
    return 'mon';
  }
  function pad(n) { return n < 10 ? '0'+n : n; }

  function renderLog() {
    try {
      var data = getWK();
      var exs = EXERCISES[curDay];
      var dd = data[curDay] || {};

      document.getElementById('logDayLabel').textContent = DAY_LABELS[curDay];
      document.getElementById('logDayPlan').textContent = DAY_PLANS[curDay];
      document.getElementById('logDate').textContent = new Date().toLocaleDateString();
      updateCoverName();

      var tabs = { mon:'dayMon', wed:'dayWed', fri:'dayFri' };
      for (var k in tabs) {
        var el = document.getElementById(tabs[k]);
        if (el) el.className = k === curDay ? 'active' : '';
      }

      var cont = document.getElementById('logExercises');
      cont.innerHTML = '';
      var total = 0, done = 0;

      exs.forEach(function(ex, ei) {
        var sets = setCount(ex.t);
        var prog = getExProg(curDay, ei);
        var maxP = ex.p ? ex.p.length - 1 : 0;
        if (prog > maxP) prog = 0;
        var displayT = ex.p ? progTarget(ex.t, prog, maxP) : ex.t;
        var displayN = ex.p ? ex.p[prog] + ' ' + ex.n : ex.n;

        var row = document.createElement('div');
        row.className = 'exercise-row';
        var nm = document.createElement('span');
        nm.className = 'ex-name';
        nm.textContent = displayN;
        row.appendChild(nm);
        var tg = document.createElement('span');
        tg.className = 'ex-target';
        tg.textContent = displayT + ' \u00b7 ' + ex.e;
        row.appendChild(tg);

        if (ex.p) {
          var progRow = document.createElement('div');
          progRow.className = 'prog-chain';
          ex.p.forEach(function(step, pi) {
            var sp = document.createElement('span');
            sp.className = 'prog-step' + (pi === prog ? ' active' : '') + (pi < prog ? ' done' : '');
            sp.textContent = step;
            sp.onclick = function() { setExProg(curDay, ei, pi); renderLog(); };
            progRow.appendChild(sp);
            if (pi < ex.p.length - 1) {
              var arr = document.createTextNode(' \u2192 ');
              progRow.appendChild(arr);
            }
          });
          row.appendChild(progRow);
        }
        var grp = document.createElement('div');
        grp.className = 'set-group';
        for (var s = 0; s < sets; s++) {
          var key = ei + '-' + s;
          var raw = dd[key];
          var reps = 0;
          if (typeof raw === 'number') reps = raw;
          else if (raw === true) reps = -1; // old boolean data, means done but reps unknown
          var done = reps > 0 || reps === -1;

          var lbl = document.createElement('label');
          lbl.className = 'set-check' + (done ? ' done' : '');

          var box = document.createElement('span');
          box.className = 'box';
          lbl.appendChild(box);

          var setLabel = document.createTextNode('Set ' + (s+1) + ' ');
          lbl.appendChild(setLabel);

          var repLabel = document.createElement('span');
          repLabel.className = 'rep-label';
          repLabel.textContent = 'reps:';
          lbl.appendChild(repLabel);

          var repInput = document.createElement('input');
          repInput.type = 'number';
          repInput.className = 'rep-input';
          repInput.value = reps > 0 ? reps : '';
          repInput.min = 0;
          repInput.placeholder = displayT.match(/(\d+)/) ? displayT.match(/(\d+)/)[1] : '0';
          (function(ei, s) {
            repInput.onchange = function() { updateReps(curDay, ei, s, parseInt(this.value) || 0); };
            repInput.onkeyup = function(e) { if (e.key === 'Enter') { this.blur(); updateReps(curDay, ei, s, parseInt(this.value) || 0); } };
            repInput.onmousedown = function(e) { e.stopPropagation(); };
          })(ei, s);
          lbl.appendChild(repInput);

          (function(done, ei, s) {
            lbl.onclick = function(e) {
              if (e.target.tagName === 'INPUT') return;
              updateReps(curDay, ei, s, done ? 0 : defaultRepsFromTarget(displayT));
            };
          })(done, ei, s);

          grp.appendChild(lbl);
          total++;
          if (done) done++;
        }
        row.appendChild(grp);
        cont.appendChild(row);
      });

      document.getElementById('logDone').textContent = done;
      document.getElementById('logTotal').textContent = total;
      document.getElementById('logProgress').style.width = (total > 0 ? (done/total*100) : 0) + '%';
      renderWeekStats();
    } catch(e) { console.error('renderLog error:', e); }
  }

  function updateReps(day, ei, si, reps) {
    var data = getWK();
    if (!data[day]) data[day] = {};
    var key = ei + '-' + si;
    if (reps > 0) {
      data[day][key] = reps;
      // auto-fill previous sets in same exercise
      for (var s = 0; s < si; s++) {
        var k = ei + '-' + s;
        if (!data[day][k] || data[day][k] === true) data[day][k] = reps;
      }
    } else {
      data[day][key] = 0;
    }
    saveWK(data);
    renderLog();
  }

  function selectDay(d) { curDay = d; renderLog(); }

  function renderWeekStats() {
    var data = getWK();
    var total = 0;
    DAYS.forEach(function(d) {
      var dd = data[d] || {};
      var cnt = 0;
      for (var k in dd) { if (dd[k]) cnt++; }
      total += cnt;
      var map = { mon:'statMon', wed:'statWed', fri:'statFri' };
      var el = document.getElementById(map[d]);
      if (el) el.querySelector('.val').textContent = cnt || '\u2014';
    });
    document.getElementById('statWeek').querySelector('.val').textContent = total;
  }

  function resetWeek() {
    if (!confirm('Reset all workout data for this week?')) return;
    saveWK({ mon:{}, wed:{}, fri:{} });
    renderLog();
  }

  // ====== REST TIMER ======
  var audioCtx = null;
  function ensureAudio() {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    if (audioCtx.state === 'suspended') audioCtx.resume();
  }
  function beep() {
    try {
      ensureAudio();
      var osc = audioCtx.createOscillator();
      var gain = audioCtx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(880, audioCtx.currentTime);
      gain.gain.setValueAtTime(0.4, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.5);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start();
      osc.stop(audioCtx.currentTime + 0.5);
    } catch(e) {}
  }

  function setRest(s) {
    restSec = s;
    document.getElementById('timerDisplay').textContent = Math.floor(s/60) + ':' + pad(s%60);
    if (restInt) { clearInterval(restInt); restInt = null; }
    restRun = false;
    document.getElementById('restTimer').classList.remove('running');
    document.getElementById('restStartStop').textContent = 'Start';
  }

  function startRest() {
    if (restRun) {
      clearInterval(restInt); restInt = null; restRun = false;
      document.getElementById('restTimer').classList.remove('running');
      document.getElementById('restStartStop').textContent = 'Start';
      return;
    }
    ensureAudio(); // init audio on user gesture
    restRun = true;
    document.getElementById('restTimer').classList.add('running');
    document.getElementById('restStartStop').textContent = 'Stop';
    var s = restSec;
    document.getElementById('timerDisplay').textContent = Math.floor(s/60) + ':' + pad(s%60);
    restInt = setInterval(function() {
      s--;
      if (s <= 0) {
        clearInterval(restInt); restInt = null; restRun = false;
        document.getElementById('restTimer').classList.remove('running');
        document.getElementById('restStartStop').textContent = 'Start';
        s = restSec;
        beep();
      }
      document.getElementById('timerDisplay').textContent = Math.floor(s/60) + ':' + pad(s%60);
    }, 1000);
  }

  function resetRest() {
    if (restInt) { clearInterval(restInt); restInt = null; }
    restRun = false;
    document.getElementById('restTimer').classList.remove('running');
    document.getElementById('restStartStop').textContent = 'Start';
    document.getElementById('timerDisplay').textContent = Math.floor(restSec/60) + ':' + pad(restSec%60);
  }

  // ====== CALENDAR ======
  var calY, calM;
  function initCal() {
    var n = new Date();
    calY = n.getFullYear();
    calM = n.getMonth();
    renderCal();
  }
  function calDelta(d) {
    calM += d;
    if (calM < 0) { calM = 11; calY--; }
    if (calM > 11) { calM = 0; calY++; }
    renderCal();
  }
  function renderCal() {
    var names = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    document.getElementById('calLabel').textContent = names[calM] + ' ' + calY;
    var grid = document.getElementById('calGrid');
    grid.innerHTML = '';
    var hd = ['Su','Mo','Tu','We','Th','Fr','Sa'];
    hd.forEach(function(d) {
      var h = document.createElement('div');
      h.className = 'ch';
      h.textContent = d;
      grid.appendChild(h);
    });
    var first = new Date(calY, calM, 1).getDay();
    var days = new Date(calY, calM + 1, 0).getDate();
    var today = new Date();
    var wk = getWK();
    for (var i = 0; i < first; i++) {
      var e = document.createElement('div');
      e.className = 'cd other';
      grid.appendChild(e);
    }
    for (var d = 1; d <= days; d++) {
      var e = document.createElement('div');
      e.className = 'cd';
      e.textContent = d;
      var dt = new Date(calY, calM, d);
      if (dt.toDateString() === today.toDateString()) e.classList.add('today');
      var dow = dt.getDay();
      var dk = {1:'mon',3:'wed',5:'fri'}[dow];
      if (dk && wk[dk]) {
        var cnt = 0;
        for (var k in wk[dk]) { if (wk[dk][k]) cnt++; }
        if (cnt > 0) e.classList.add('has-workout');
      }
      grid.appendChild(e);
    }
  }

  // ====== PROGRESS ======
  function getProg() { return loadData('progress', []); }
  function saveProg(d) { saveData('progress', d); }
  function getMeas() { return loadData('measurements', []); }
  function saveMeas(d) { saveData('measurements', d); }
  function getProf() { return loadData('profile', { name:'Ismail', goal:'', start:'' }); }

  function saveProf() {
    var p = {
      name: document.getElementById('profName').value,
      goal: document.getElementById('profGoal').value,
      start: document.getElementById('profStart').value
    };
    saveData('profile', p);
    updateCoverName();
  }

  function loadProf() {
    var p = getProf();
    document.getElementById('profName').value = p.name || 'Ismail';
    document.getElementById('profGoal').value = p.goal || '';
    document.getElementById('profStart').value = p.start || '';
    updateCoverName();
  }
  function updateCoverName() {
    var el = document.getElementById('coverName');
    if (el) el.textContent = document.getElementById('profName').value || 'Ismail';
  }

  function addEntry() {
    var week = parseInt(document.getElementById('entryWeek').value);
    var weight = parseFloat(document.getElementById('entryWeight').value);
    if (!weight) { alert('Enter at least your weight'); return; }
    var pullup = parseInt(document.getElementById('entryPullup').value) || 0;
    var dip = parseInt(document.getElementById('entryDip').value) || 0;
    var lsit = parseInt(document.getElementById('entryLsit').value) || 0;
    var notes = document.getElementById('entryNotes').value || '';
    var data = getProg();
    var idx = data.findIndex(function(e) { return e.week === week; });
    var entry = { week:week, weight:weight, pullup:pullup, dip:dip, lsit:lsit, notes:notes, date:new Date().toISOString().slice(0,10) };
    if (idx >= 0) data[idx] = entry;
    else data.push(entry);
    data.sort(function(a,b) { return a.week - b.week; });
    saveProg(data);
    refreshTracker();
    document.getElementById('entryWeight').value = '';
    document.getElementById('entryPullup').value = '';
    document.getElementById('entryDip').value = '';
    document.getElementById('entryLsit').value = '';
    document.getElementById('entryNotes').value = '';
    document.getElementById('entryWeek').value = data.length + 1;
  }

  function delEntry(week) {
    var data = getProg().filter(function(e) { return e.week !== week; });
    saveProg(data);
    refreshTracker();
  }

  function saveMeas() {
    var week = parseInt(document.getElementById('entryWeek').value);
    var arm = parseFloat(document.getElementById('measArm').value) || 0;
    var chest = parseFloat(document.getElementById('measChest').value) || 0;
    var waist = parseFloat(document.getElementById('measWaist').value) || 0;
    var thigh = parseFloat(document.getElementById('measThigh').value) || 0;
    if (!arm && !chest && !waist && !thigh) { alert('Enter at least one measurement'); return; }
    var data = getMeas();
    var idx = data.findIndex(function(e) { return e.week === week; });
    var entry = { week:week, arm:arm, chest:chest, waist:waist, thigh:thigh };
    if (idx >= 0) data[idx] = entry;
    else data.push(entry);
    data.sort(function(a,b) { return a.week - b.week; });
    saveMeas(data);
    refreshTracker();
    document.getElementById('measArm').value = '';
    document.getElementById('measChest').value = '';
    document.getElementById('measWaist').value = '';
    document.getElementById('measThigh').value = '';
  }

  function refreshTracker() {
    renderHistory();
    renderChart();
  }

  // ====== CHART ======
  function renderChart() {
    try {
      var data = getProg();
      var box = document.getElementById('chartBox');
      if (!data || data.length < 2) {
        box.innerHTML = '<p style="color:var(--text-dim);font-size:14px;">' + (data.length === 1 ? 'Add one more weekly entry to see your progress chart.' : 'Add weekly entries to see your progress chart.') + '</p>';
        return;
      }
      var W = 600, H = 280, PT = 20, PR = 20, PB = 40, PL = 50;
      var CW = W - PL - PR, CH = H - PT - PB;
      var weeks = [], weights = [], pullups = [], dips = [];
      data.forEach(function(e) {
        weeks.push(e.week);
        weights.push(e.weight);
        pullups.push(e.pullup || 0);
        dips.push(e.dip || 0);
      });
      var maxW = Math.max.apply(null, weights);
      var minW = Math.min.apply(null, weights);
      var wR = maxW - minW || 1;
      var maxR = Math.max.apply(null, pullups.concat(dips).concat([1]));
      var xS = function(w) { return PL + (w - weeks[0]) / (weeks[weeks.length-1] - weeks[0] || 1) * CW; };
      var yW = function(v) { return PT + CH - (v - minW) / wR * CH; };
      var yR = function(v) { return PT + CH - v / maxR * CH; };
      var svg = '<svg viewBox="0 0 '+W+' '+H+'" style="width:100%;max-width:100%;height:auto;">';
      for (var i = 0; i <= 5; i++) {
        var y = PT + (CH / 5) * i;
        svg += '<line x1="'+PL+'" y1="'+y+'" x2="'+(W-PR)+'" y2="'+y+'" stroke="#555" stroke-width="0.5" opacity="0.3"/>';
        svg += '<text x="'+(PL-8)+'" y="'+(y+4)+'" text-anchor="end" fill="#888" font-size="10">'+(maxW - (wR/5)*i).toFixed(1)+'</text>';
      }
      weeks.forEach(function(w) {
        svg += '<text x="'+xS(w)+'" y="'+(H-PB+16)+'" text-anchor="middle" fill="#888" font-size="10">W'+w+'</text>';
      });
      if (weights.length >= 2) {
        var d = '';
        for (var i = 0; i < weeks.length; i++) {
          d += (i === 0 ? 'M' : 'L') + xS(weeks[i]) + ' ' + yW(weights[i]);
        }
        svg += '<path d="'+d+'" stroke="#e94560" stroke-width="2.5" fill="none" stroke-linejoin="round"/>';
        for (var i = 0; i < weeks.length; i++) {
          svg += '<circle cx="'+xS(weeks[i])+'" cy="'+yW(weights[i])+'" r="4" fill="#e94560"/>';
        }
      }
      if (pullups.some(function(p) { return p > 0; })) {
        var d = '';
        for (var i = 0; i < weeks.length; i++) {
          if (pullups[i] > 0 || d !== '') {
            d += (d === '' ? 'M' : 'L') + xS(weeks[i]) + ' ' + yR(pullups[i]);
          }
        }
        if (d) {
          svg += '<path d="'+d+'" stroke="#4ecca3" stroke-width="2" fill="none" stroke-dasharray="6 3" stroke-linejoin="round"/>';
          for (var i = 0; i < weeks.length; i++) {
            if (pullups[i] > 0) svg += '<circle cx="'+xS(weeks[i])+'" cy="'+yR(pullups[i])+'" r="3.5" fill="#4ecca3"/>';
          }
        }
      }
      if (dips.some(function(p) { return p > 0; })) {
        var d = '';
        for (var i = 0; i < weeks.length; i++) {
          if (dips[i] > 0 || d !== '') {
            d += (d === '' ? 'M' : 'L') + xS(weeks[i]) + ' ' + yR(dips[i]);
          }
        }
        if (d) {
          svg += '<path d="'+d+'" stroke="#5352ed" stroke-width="2" fill="none" stroke-dasharray="4 4" stroke-linejoin="round"/>';
          for (var i = 0; i < weeks.length; i++) {
            if (dips[i] > 0) svg += '<circle cx="'+xS(weeks[i])+'" cy="'+yR(dips[i])+'" r="3.5" fill="#5352ed"/>';
          }
        }
      }
      svg += '</svg>';
      box.innerHTML = svg;
    } catch(e) { console.error('chart error:', e); }
  }

  // ====== HISTORY ======
  function renderHistory() {
    try {
      var data = getProg();
      var meas = getMeas();
      var box = document.getElementById('historyBox');
      if (!data.length) { box.innerHTML = '<p style="color:var(--text-dim);font-size:14px;">No entries yet. Log your first week above!</p>'; updateMiles(data); return; }
      var h = '<table class="history-table"><thead><tr><th>Week</th><th>Date</th><th>Weight</th><th>Pull-Up</th><th>Dip</th><th>L-Sit</th><th>Arm</th><th>Chest</th><th>Notes</th><th></th></tr></thead><tbody>';
      data.forEach(function(e) {
        var m = null;
        for (var i = 0; i < meas.length; i++) { if (meas[i].week === e.week) { m = meas[i]; break; } }
        h += '<tr><td>'+e.week+'</td><td>'+e.date+'</td><td><strong>'+e.weight+' kg</strong></td><td>'+e.pullup+'</td><td>'+e.dip+'</td><td>'+e.lsit+'s</td>';
        h += '<td>'+(m && m.arm ? m.arm+'cm' : '\u2014')+'</td>';
        h += '<td>'+(m && m.chest ? m.chest+'cm' : '\u2014')+'</td>';
        h += '<td style="font-size:12px;color:var(--text-dim);">'+(e.notes||'')+'</td>';
        h += '<td><button class="del-btn" data-week="'+e.week+'">\u2715</button></td></tr>';
      });
      h += '</tbody></table>';
      if (data.length >= 2) {
        var diff = (data[data.length-1].weight - data[0].weight).toFixed(1);
        h += '<p style="margin-top:12px;font-size:14px;">Change from week 1: <strong style="color:'+(diff>0?'#4ecca3':'#e94560')+';">'+(diff>0?'+':'')+diff+' kg</strong></p>';
      }
      box.innerHTML = h;
      box.querySelectorAll('.del-btn').forEach(function(btn) {
        btn.onclick = function() { delEntry(parseInt(this.dataset.week)); };
      });
      updateMiles(data);
    } catch(e) { console.error('history error:', e); }
  }

  function updateMiles(data) {
    var maxPull = 0, maxDip = 0, maxLsit = 0;
    data.forEach(function(e) {
      if (e.pullup > maxPull) maxPull = e.pullup;
      if (e.dip > maxDip) maxDip = e.dip;
      if (e.lsit > maxLsit) maxLsit = e.lsit;
    });
    var ids = { m1: maxPull >= 1, m5: maxPull >= 5, m10: maxDip >= 10, m30: maxLsit >= 30, mp: false };
    for (var k in ids) {
      var el = document.getElementById(k);
      if (el) el.style.opacity = ids[k] ? 1 : 0.3;
    }
  }

  // ====== EXPORT/IMPORT/CLEAR ======
  function exportData() {
    var d = {
      version: 1,
      exported: new Date().toISOString(),
      profile: getProf(),
      workout: getWK(),
      progress: getProg(),
      measurements: getMeas(),
      theme: getTheme()
    };
    var blob = new Blob([JSON.stringify(d, null, 2)], { type:'application/json' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = 'icb_backup_' + new Date().toISOString().slice(0,10) + '.json';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  function importData(file) {
    if (!file) return;
    var reader = new FileReader();
    reader.onload = function(e) {
      try {
        var d = JSON.parse(e.target.result);
        if (!d.version) { alert('Invalid backup file'); return; }
        if (d.profile) saveData('profile', d.profile);
        if (d.workout) saveData('workout', d.workout);
        if (d.progress) saveData('progress', d.progress);
        if (d.measurements) saveData('measurements', d.measurements);
        if (d.theme) setTheme(d.theme);
        alert('Backup restored successfully!');
        location.reload();
      } catch(err) { alert('Failed to restore backup: ' + err.message); }
    };
    reader.readAsText(file);
  }

  function clearAll() {
    if (!confirm('Delete ALL data? This cannot be undone!')) return;
    if (!confirm('Are you sure? All workouts, progress, and measurements will be gone.')) return;
    var keys = Object.keys(localStorage).filter(function(k) { return k.indexOf('icb_') === 0; });
    keys.forEach(function(k) { localStorage.removeItem(k); });
    location.reload();
  }

  // ====== NAVIGATION ======
  function switchPage(page) {
    document.querySelectorAll('.nav-links a').forEach(function(l) { l.className = ''; });
    document.querySelectorAll('.page-content').forEach(function(p) { p.classList.remove('active'); });
    var link = document.querySelector('.nav-links a[data-page="'+page+'"]');
    if (link) link.className = 'active';
    var pg = document.getElementById('page-'+page);
    if (pg) pg.classList.add('active');
    if (page === 'log') { showQuote(); renderLog(); }
    if (page === 'tracker') { loadProf(); refreshTracker(); }
  }

  // ====== BIND EVENTS ======
  function init() {
    try {
      setTheme(getTheme());
      curDay = todayKey();
      showQuote();

      // Nav links
      document.querySelectorAll('.nav-links a').forEach(function(a) {
        a.onclick = function() { switchPage(this.dataset.page); };
      });

      // Theme
      document.getElementById('themeBtn').onclick = toggleTheme;

      // Day selectors
      document.getElementById('dayMon').onclick = function() { selectDay('mon'); };
      document.getElementById('dayWed').onclick = function() { selectDay('wed'); };
      document.getElementById('dayFri').onclick = function() { selectDay('fri'); };

      // Rest timer
      document.getElementById('restStartStop').onclick = startRest;
      document.getElementById('restReset').onclick = resetRest;
      document.querySelectorAll('[data-rest]').forEach(function(b) {
        b.onclick = function() { setRest(parseInt(this.dataset.rest)); };
      });
      document.getElementById('applyRest').onclick = function() {
        var v = parseInt(document.getElementById('customRest').value);
        if (v >= 5 && v <= 600) setRest(v);
      };
      document.getElementById('customRest').onkeyup = function(e) {
        if (e.key === 'Enter') {
          var v = parseInt(this.value);
          if (v >= 5 && v <= 600) setRest(v);
        }
      };

      // Reset week
      document.getElementById('resetWeek').onclick = resetWeek;

      // Calendar
      document.getElementById('calPrev').onclick = function() { calDelta(-1); };
      document.getElementById('calNext').onclick = function() { calDelta(1); };

      // Tracker
      document.getElementById('saveEntry').onclick = addEntry;
      document.getElementById('saveMeas').onclick = saveMeas;
      document.getElementById('profName').onchange = saveProf;
      document.getElementById('profGoal').onchange = saveProf;
      document.getElementById('profStart').onchange = saveProf;

      // Export/Import
      document.getElementById('exportBtn').onclick = exportData;
      document.getElementById('importBtn').onclick = function() { document.getElementById('importInput').click(); };
      document.getElementById('importInput').onchange = function() { importData(this.files[0]); this.value = ''; };
      document.getElementById('clearBtn').onclick = clearAll;

      // Initial render
      loadProf();
      renderLog();
      refreshTracker();
      setRest(90);
      initCal();
    } catch(e) { console.error('init error:', e); }
  }

  // Start when DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
</body>
  </html>
