    <tr><td>1</td><td><strong>Australian Rows</strong></td><td>4 &times; 10-15</td><td>Under pull-up bar</td></tr>
    <tr><td>2</td><td><strong>Pike Push-Ups</strong></td><td>4 &times; 8-12</td><td>Yoga mat</td></tr>
    <tr><td>3</td><td><strong>Bulgarian Split Squats</strong></td><td>3 &times; 8-12/leg</td><td>Yoga mat + chair</td></tr>
    <tr><td>4</td><td><strong>Glute Bridges</strong></td><td>3 &times; 15-20</td><td>Yoga mat</td></tr>
    <tr><td>5</td><td><strong>Leg Raises</strong></td><td>3 &times; 10-15</td><td>Yoga mat</td></tr>
    <tr><td>6</td><td><strong>Plank</strong></td><td>3 &times; 30-60s</td><td>Yoga mat</td></tr>
  </tbody></table>
</div>
<div class="day-card">
  <div class="day-header"><h3>Friday &mdash; Full Body C</h3><span class="day-badge">Day 3</span></div>
  <table><thead><tr><th>#</th><th>Exercise</th><th>Sets&times;Reps</th><th>Equipment</th></tr></thead><tbody>
    <tr><td>1</td><td><strong>Pull-Ups</strong></td><td>4 &times; 3-8</td><td>Pull-up bar</td></tr>
