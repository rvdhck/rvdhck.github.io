<div class="page">
<div class="chapter"><div class="chapter-number">Interactive</div><h2>Log Workout</h2><p>Check off your sets as you complete them. Data saves automatically.</p></div>

<div class="quote-card" id="quoteCard">
  <div class="qt" id="quoteText">The only bad workout is the one that didn't happen.</div>
  <div class="qa" id="quoteAuthor">&mdash; Unknown</div>
</div>

<div class="track-card">
  <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;">
    <div>
      <h3 style="margin:0;font-size:1.1rem;" id="logDayLabel">Today &mdash; Monday</h3>
      <p style="margin:4px 0 0;font-size:13px;color:var(--text-dim);" id="logDayPlan">Full Body A</p>
    </div>
    <div style="text-align:right;">
      <div class="progress-stats">
        <span id="logDone">0</span><span>/</span><span id="logTotal">0</span><span> sets done</span>
      </div>
      <div class="progress-bar-wrap" style="width:200px;max-width:100%;">
        <div class="progress-bar-fill" id="logProgress"></div>
      </div>
    </div>
  </div>
</div>

<div class="week-selector">
  <button id="dayMon">Mon</button>
  <button id="dayWed">Wed</button>
  <button id="dayFri">Fri</button>
  <span style="color:var(--text-dim);font-size:13px;margin-left:8px;" id="logDate"></span>
</div>

<div id="logExercises"></div>

<div class="track-card">
  <h3 style="margin:0 0 10px;">Rest Timer</h3>
  <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;">
    <div class="rest-timer" id="restTimer">
      <span>Rest:</span>
      <span class="time" id="timerDisplay">1:30</span>
      <button id="restStartStop">Start</button>
      <button id="restReset">Reset</button>
    </div>
    <div style="display:flex;gap:6px;align-items:center;">
      <span style="font-size:12px;color:var(--text-dim);">Preset:</span>
      <button class="btn btn-secondary btn-sm" data-rest="60">60s</button>
      <button class="btn btn-secondary btn-sm" data-rest="90">90s</button>
      <button class="btn btn-secondary btn-sm" data-rest="120">2min</button>
      <button class="btn btn-secondary btn-sm" data-rest="180">3min</button>
    </div>
    <div style="display:flex;gap:6px;align-items:center;">
      <span style="font-size:12px;color:var(--text-dim);">Custom:</span>
      <input type="number" class="custom-rest-input" id="customRest" value="90" min="5" max="600">
      <button class="btn btn-primary btn-sm" id="applyRest">Set</button>
    </div>
  </div>
</div>

<div class="track-card">
  <h3 style="margin:0 0 12px;">This Week</h3>
  <div class="dash-row">
    <div class="dash-stat" id="statMon"><div class="val">&mdash;</div><div class="lbl">Monday</div></div>
    <div class="dash-stat" id="statWed"><div class="val">&mdash;</div><div class="lbl">Wednesday</div></div>
    <div class="dash-stat" id="statFri"><div class="val">&mdash;</div><div class="lbl">Friday</div></div>
    <div class="dash-stat" id="statWeek"><div class="val">0</div><div class="lbl">Total sets</div></div>
  </div>
  <button class="btn btn-danger btn-sm" id="resetWeek">Reset This Week</button>
</div>

